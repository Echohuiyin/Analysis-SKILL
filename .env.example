# AiCrasher Configuration
# =======================
# Copy this file to .env and fill in your values.

# ============================================================
# LLM API Credentials (choose one provider)
# ============================================================

# Option 1: Azure OpenAI (recommended for enterprise)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Option 2: OpenAI API
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Application Settings
# ============================================================

# CLI tool preference (auto-detected if not set)
# Options: codebuddy | claude | mcporter | auto
AICRASHER_CLI_TOOL=auto

# Workspace for generated artifacts (default: current directory)
AICRASHER_WORKSPACE=

# ============================================================
# Crash Utility Settings
# ============================================================

CRASH_BINARY=/usr/bin/crash
CRASH_TIMEOUT_SECONDS=300
CRASH_OUTPUT_MAX_CHARS=16384
CRASH_BATCH_OUTPUT_MAX_CHARS=32768
# ============================================================
# AI Orchestration Settings
# ============================================================

MAX_AI_ROUNDS=12
AI_COMMAND_BATCH_SIZE=3

# ============================================================
# Knowledge Base Settings
# ============================================================

# Local knowledge base paths (separated by : on Linux, ; on Windows)
KNOWLEDGE_BASE_PATHS=

# Red Hat Customer Portal KB API (public, no auth required)
REDHAT_KB_ENABLED=true
REDHAT_KB_BASE_URL=https://access.redhat.com/hydra/rest/search/platform/kbase
REDHAT_KB_TIMEOUT_SECONDS=10
REDHAT_KB_MAX_RESULTS=5

# ============================================================
# Embedding Service Settings (for RAG case retrieval)
# ============================================================
# The RAG skill converts text to vectors using an OpenAI-compatible
# /v1/embeddings endpoint. Supported backends:
#   - Ollama (local):      http://localhost:11434/v1
#   - OpenAI (cloud):      https://api.openai.com/v1
#   - text-embeddings-inference (local): http://localhost:8080/v1
#   - Any OpenAI-compatible service

# Local Ollama (default, no data leakage)
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=not-required

# Cloud embedding (comment out local config above and uncomment below)
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=sk-your-key-here

# Advanced (optional, defaults shown)
# EMBEDDING_TIMEOUT=30
# EMBEDDING_BATCH_SIZE=100
# EMBEDDING_DIMENSION=768
# EMBEDDING_MAX_TOKENS=512

# ============================================================
# Feature Flags
# ============================================================

FEATURE_BASIC_ANALYSIS=true
FEATURE_KNOWLEDGE_SEARCH=true
FEATURE_REPORT_GENERATION=true
